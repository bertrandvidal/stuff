(version 1)

# JLCPCB limits for a 2-layer, 1 oz, 1.6 mm FR4 board
# (https://jlcpcb.com/capabilities/pcb-capabilities, checked 2026-09-26).
# Only the limits that Board Setup and the Default netclass don't already
# enforce at least as strictly: tracks/clearance are 0.2 mm (JLC: 0.10),
# copper-to-edge is 0.5 mm (JLC: 0.2), vias are 0.3/0.6 mm (JLC: 0.15/0.25).

(rule "JLC: PTH annular ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.18mm)))

(rule "JLC: NPTH hole size"
	(condition "A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

(rule "JLC: hole to hole, different nets"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC: silkscreen text"
	(layer "?.Silkscreen")
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm)))
