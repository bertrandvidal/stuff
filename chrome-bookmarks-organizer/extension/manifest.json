{
  "manifest_version": 3,
  "name": "Chrome Bookmarks Organizer",
  "version": "1.0.0",
  "description": "Files bookmarks from an inbox folder into the right folder of your bookmark tree, using Claude Code on this Mac.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["bookmarks", "storage", "alarms", "nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Chrome Bookmarks Organizer" }
}
